target/
.env
.env.local
**/.env.local
.sui/
contracts/build/
contracts/Move.lock
.claude/

# Workspace artifacts
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
**/.vite/
*.tsbuildinfo
**/*.tsbuildinfo

# wasm-pack output: generated from crates/*-wasm Rust sources on demand by the
# consuming app's `wasm` build script. Never committed.
crates/*-wasm/pkg/

# Local artifacts that shouldn't ever be committed
publish-output.json
publish-testnet.json
publish-mainnet.json

# Working directory for the local deploy script (scripts/deploy-devnet.ps1)
out/

# Playwright MCP debug session captures
.playwright-mcp/

# Playwright test artifacts. Generated by `pnpm test` in any app
# that uses @playwright/test (currently apps/zk). Not committed.
**/playwright-report/
**/test-results/

# Groth16 PK/VK artifacts produced by the prover-server on first
# boot. Per `specs/zk/stack.md § Artifact discipline`, these are
# deployment artifacts, not source-controlled. The dev path
# regenerates them with a deterministic seed; production needs a
# real ceremony.
keys/

# Loose debug screenshots (commit them to specs/ if you want to keep one)
*.debug.png
identity-bar-fixed.png

# pnpm temp
.pnpm-store/

# Sibling work-tree clones used to develop upstream patches; not part of
# this repo's workspace. Keep at the repo root only — fork lives at
# https://github.com/0xErgod/evevault.
.evevault/
