{
  "name": "@whisper-protocol/sdk",
  "version": "0.0.0-development",
  "description": "Client SDK for the Whisper Protocol — encrypt, decrypt, and post envelopes over Sui.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./networks": {
      "types": "./dist/networks.d.ts",
      "import": "./dist/networks.js"
    },
    "./feed": {
      "types": "./dist/feed.d.ts",
      "import": "./dist/feed.js"
    }
  },
  "scripts": {
    "wasm": "wasm-pack build ../../crates/crypto-wasm --target bundler --out-dir pkg --out-name crypto_wasm --release",
    "gen:networks": "node scripts/generate-networks.mjs",
    "gen:networks:check": "node scripts/generate-networks.mjs --check",
    "prebuild": "pnpm run wasm && node scripts/generate-networks.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm run wasm",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@mysten/sui": "^1.38.0",
    "crypto-wasm": "link:../../crates/crypto-wasm/pkg"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vite-plugin-wasm": "^3.4.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xErgod/whisper-protocol.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "sui",
    "whisper",
    "babyjub",
    "poseidon",
    "zk",
    "encryption",
    "messaging",
    "privacy"
  ]
}
