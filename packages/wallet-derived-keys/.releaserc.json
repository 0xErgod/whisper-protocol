{
  "$schema": "https://json.schemastore.org/semantic-release",
  "extends": "../../.releaserc.base.json",
  "tagFormat": "wallet-derived-v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "scope": "wallet-derived-keys", "type": "feat", "release": "minor" },
          { "scope": "wallet-derived-keys", "type": "fix", "release": "patch" },
          { "scope": "wallet-derived-keys", "type": "perf", "release": "patch" },
          { "scope": "wallet-derived-keys", "type": "refactor", "release": "patch" },
          { "scope": "wallet-derived-keys", "breaking": true, "release": "major" },
          { "scope": "sdk", "release": false },
          { "scope": "apps", "release": false },
          { "scope": "web", "release": false },
          { "scope": "crypto", "release": false },
          { "scope": "crypto-wasm", "release": false },
          { "scope": "ci", "release": false },
          { "scope": "deps", "release": false },
          { "scope": "release", "release": false }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "Features" },
            { "type": "fix", "section": "Bug Fixes" },
            { "type": "perf", "section": "Performance" },
            { "type": "refactor", "section": "Refactors" },
            { "type": "docs", "section": "Documentation", "hidden": false },
            { "type": "chore", "hidden": true },
            { "type": "ci", "hidden": true },
            { "type": "test", "hidden": true }
          ]
        }
      }
    ],
    [
      "@semantic-release/npm",
      {
        "pkgRoot": ".",
        "tarballDir": "release-artifacts"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "release-artifacts/*.tgz", "label": "npm tarball" }
        ]
      }
    ]
  ]
}
