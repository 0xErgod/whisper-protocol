{
  "name": "@whisper-protocol/wallet-derived-keys",
  "version": "0.0.0-development",
  "description": "Derive a stable X25519 encryption keypair from a Sui wallet's personal-message signature.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xErgod/whisper-protocol.git",
    "directory": "packages/wallet-derived-keys"
  },
  "keywords": [
    "sui",
    "whisper",
    "encryption",
    "wallet",
    "x25519",
    "key-derivation"
  ]
}
