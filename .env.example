# Local Sui RPC used by the PoC.
SUI_RPC_URL=http://127.0.0.1:9000

# Published package ID after `sui client publish contracts`.
SUI_PACKAGE_ID=

# Shared KeyRegistry object id. Created at publish time by the module's
# init function; copy it from the publish output's `objectChanges` entry
# whose objectType ends in `::secret_sharing::KeyRegistry`.
SUI_REGISTRY_ID=

# Optional demo-only in-browser signer for custom networks that browser
# wallets cannot target. Use local/dev funds only.
VITE_ENABLE_DEV_SIGNER=false

# Single-key (legacy) form. Used only when VITE_DEV_SIGNER_KEYS is unset.
VITE_DEV_SIGNER_LABEL=alice
VITE_DEV_SIGNER_SECRET_KEY=

# Multi-key form. JSON object of { label: secret }. Each secret may be a
# `suiprivkey...` string or a 32-byte hex private key. The last-selected
# label is persisted in localStorage; on first load the first key wins.
# Example (single-line; do not commit real keys):
#   VITE_DEV_SIGNER_KEYS={"alice":"suiprivkey1...","bob":"suiprivkey1...","charlie":"suiprivkey1..."}
VITE_DEV_SIGNER_KEYS=

# Demo Ed25519 private keys.
# Use local/dev keys only. Do not commit real keys.
# Supported PoC input formats are added by the CLI implementation.
ALICE_ED25519_PRIVATE_KEY=
BOB_ED25519_PRIVATE_KEY=
CHARLIE_ED25519_PRIVATE_KEY=
