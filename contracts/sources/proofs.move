/// On-chain Groth16 verification for the protocol's circuits.
///
/// One thin wrapper per circuit around
/// `sui::groth16::verify_groth16_proof`. Each wrapper:
/// 1. Builds a `PreparedVerifyingKey` from a hardcoded `VK_*`
///    constant.
/// 2. Packs the caller-supplied public inputs into BCS bytes
///    (each `u256` is 32 little-endian bytes — the encoding
///    `prover::verify` uses on the Rust side, and the encoding
///    Sui's native verifier expects).
/// 3. Verifies the proof. On success, emits a `ProofVerified`
///    event with the circuit's public inputs so off-chain
///    indexers can record what was verified. On failure, aborts.
///
/// The VK byte arrays are produced by
/// [`crates/prover/src/bin/export-vks.rs`](../../crates/prover/src/bin/export-vks.rs)
/// — Groth16 trusted setup under a deterministic seed (see
/// `specs/zk/stack.md § Setup randomness`). The deploy script
/// (`scripts/deploy-devnet.ps1`) re-runs the binary at deploy
/// time and refuses to publish if the regenerated VKs differ
/// from the bytes pasted below — a drift between this source
/// and the seed-determined VK is a load-bearing breakage.
///
/// **Phase scope.** This module verifies + emits an event. It
/// does NOT mutate commitment state on a successful opening
/// proof. Phase 5 (issue #39) adds the
/// `commitments::open_with_proof` flow that consumes this
/// verification to gate a partial-open event.
module whisper_protocol::proofs;

use sui::bcs;
use sui::event;
use sui::groth16;

const E_INVALID_PROOF: u64 = 200;

/// Emitted when a `verify_*` call accepts a proof. The
/// `circuit` tag lets indexers route per-circuit; the public
/// inputs are repeated in canonical order so the event is
/// self-describing.
public struct ProofVerified has copy, drop {
    circuit: vector<u8>,
    public_inputs: vector<u256>,
}

