# Demo dApp environment.
#
# Copy to .env.local (gitignored) and adjust for your setup.
#
# Defaults (when nothing is set):
#   VITE_SUI_NETWORK = devnet   -> http://sui-devnet:9000 from networks.json
#   VITE_PACKAGE_ID  = devnet entry's packageId   (null until first deploy)
#   VITE_REGISTRY_ID = devnet entry's registryId  (null until first deploy)
#
# After running `scripts/deploy-devnet.ps1` the packageId/registryId in
# networks.json are populated, so just `VITE_SUI_NETWORK=devnet` is enough.
# Set the VITE_* overrides below if you want to target a personal node or a
# different deployment without touching networks.json.

# Active network alias. One of: localnet, devnet, testnet, mainnet.
VITE_SUI_NETWORK=devnet

# Explicit overrides. Each, if set, beats the corresponding networks.json value.
VITE_SUI_RPC_URL=
VITE_PACKAGE_ID=
VITE_REGISTRY_ID=

# Optional: in-browser dev signer for testing flows without a wallet that
# can target the dev devnet. Use local/dev funds only — never real keys.
VITE_ENABLE_DEV_SIGNER=false

# Multi-key form. JSON object of { label: secret }. Each secret may be a
# `suiprivkey...` string or a 32-byte hex private key. The last-selected
# label is persisted in localStorage; on first load the first key wins.
# Example (single-line; do not commit real keys):
#   VITE_DEV_SIGNER_KEYS={"alice":"suiprivkey1...","bob":"suiprivkey1..."}
VITE_DEV_SIGNER_KEYS=

# Single-key fallback. Used only when VITE_DEV_SIGNER_KEYS is unset.
VITE_DEV_SIGNER_LABEL=alice
VITE_DEV_SIGNER_SECRET_KEY=
