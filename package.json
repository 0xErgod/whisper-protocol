{
  "name": "whisper-protocol",
  "private": true,
  "version": "0.0.0",
  "description": "Whisper Protocol — Sui-based private messaging. Monorepo root.",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "build:all": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "dev:web": "pnpm --filter whisper-web run dev",
    "test": "pnpm -r run test",
    "release:sdk": "pnpm --filter @whisper-protocol/sdk exec semantic-release",
    "release:wallet-derived-keys": "pnpm --filter @whisper-protocol/wallet-derived-keys exec semantic-release"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/github": "^11.0.0",
    "@semantic-release/npm": "^13.1.0",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "semantic-release": "^24.2.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@8.15.8",
  "pnpm": {
    "overrides": {
      "@mysten/sui": "1.38.0",
      "@semantic-release/npm": "^13.1.0"
    }
  }
}
